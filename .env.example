# Database is internal to Docker Compose. Change passwords before remote deployment.
POSTGRES_DB=product_memory
POSTGRES_USER=product_memory
POSTGRES_PASSWORD=product_memory_local_only

# Local host folder mounted read-only into the container.
HOST_KNOWLEDGE_DIR=./knowledge
KNOWLEDGE_DIR=/knowledge
# Semicolon-separated folders to symlink into HOST_KNOWLEDGE_DIR with `make link-knowledge`.
# Use name=/absolute/path for stable source paths, or /absolute/path to use the folder name.
KNOWLEDGE_LINKED_DIRS=
SCAN_INTERVAL_SECONDS=30
SUPPORTED_EXTENSIONS=.txt,.md,.markdown,.rst,.log,.vtt,.srt,.pdf,.docx,.pptx,.xlsx,.msg,.eml,.png,.jpg,.jpeg,.tif,.tiff,.bmp,.webp,.gif,.mp4,.mov,.m4v,.webm,.mkv,.m4a,.mp3,.wav

# Read text from pictures, scans, and images embedded in PDF/DOCX/PPTX files.
# Set ENABLE_OCR=false to index only text that is already machine readable.
ENABLE_OCR=true
# Tesseract language packs. The image ships eng and pol; add more in the Dockerfile.
OCR_LANGUAGES=eng+pol
OCR_MAX_IMAGES_PER_DOCUMENT=100
OCR_MIN_IMAGE_PIXELS=10000
OCR_MIN_CHARACTERS=12
OCR_TIMEOUT_SECONDS=30

# Keep the pictures themselves so an answer can return a screenshot, not just its text.
STORE_IMAGES=true
MAX_STORED_IMAGE_BYTES=5000000
# Where callers reach this server, so returned image links work from outside the container.
PUBLIC_BASE_URL=http://localhost:2600

# Transcribe meeting recordings locally with Whisper.
ENABLE_TRANSCRIPTION=true
# tiny, base, small, medium or large-v3. Larger is more accurate and much slower.
TRANSCRIPTION_MODEL=small
# Languages this index is meant to hold. A recording in any other language is skipped
# rather than transcribed, because a wrong-language guess reads as confident nonsense.
TRANSCRIPTION_LANGUAGES=en
# How much audio is decoded at once. This sets the memory ceiling, not the accuracy.
TRANSCRIPTION_WINDOW_SECONDS=600
# How many new recordings one scan may take on, so documents are not stuck behind audio.
TRANSCRIPTION_PER_SCAN_LIMIT=1
TRANSCRIPTION_THREADS=8
TRANSCRIPTION_BEAM_SIZE=1

# Keep the moments a shared screen changed, and read them for text.
ENABLE_VIDEO_FRAMES=true
# How different a frame must be from the last one kept. Lower keeps more.
FRAME_SCENE_THRESHOLD=0.25
# Take one anyway after this long, for a screen shared unchanged.
FRAME_MAX_INTERVAL_SECONDS=120
# Below this many readable words it is a gallery of faces, not a shared document.
FRAME_MIN_WORDS=15
FRAME_MAX_PER_RECORDING=200
FRAME_WIDTH=1280

# Chunking. A change triggers an automatic full reindex.
CHUNK_SIZE=1800
CHUNK_OVERLAP=250

# Default: multilingual, CPU-friendly local model. Polish and English are supported.
EMBEDDING_PROVIDER=local_hf
EMBEDDING_MODEL=intfloat/multilingual-e5-base
# Pin a Hugging Face commit for fully reproducible deployments. Empty means the model's current revision.
EMBEDDING_REVISION=
EMBEDDING_DIMENSIONS=
EMBEDDING_BATCH_SIZE=16
LOCAL_EMBEDDING_THREADS=4
HF_HOME=/models/huggingface

# The service reaches the internet only to fetch a model that is missing from HF_HOME, and never
# again once it is cached. Set false to forbid that too: a cold cache then fails with a clear
# error instead of pulling gigabytes, and `make warmup` becomes the only way to download.
ALLOW_MODEL_DOWNLOAD=true

# Optional remote/OpenAI-compatible embeddings. Used only when EMBEDDING_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Hybrid ranking weights. They should sum roughly to 1.0.
SEMANTIC_WEIGHT=0.72
LEXICAL_WEIGHT=0.13
RECENCY_WEIGHT=0.15
RECENCY_HALF_LIFE_DAYS=180

# Context returned to an agent.
# The floor is applied to semantic similarity only, so an older but relevant document is still returned.
MIN_SEMANTIC_SCORE=0.60
MAX_RETURNED_DOCUMENTS=25
DEFAULT_TOP_K_CHUNKS=10
DEFAULT_TOP_K_DOCUMENTS=7
DEFAULT_CONTEXT_CHARS=24000
MAX_FULL_DOCUMENT_CHARS=120000

# Reranking. A shortlist is read again with the question attached, which catches passages the
# search stage ranked below chunks that merely discuss the subject. It costs seconds per query,
# so set RERANKER_ENABLED=false where latency matters more than the answer.
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-base
# Pin a Hugging Face commit, as with EMBEDDING_REVISION. `make warmup` prints the current one.
RERANKER_REVISION=
RERANKER_WEIGHT=0.5
CANDIDATE_POOL_CHUNKS=40
CANDIDATE_POOL_PER_SIGNAL=25
# How many chunks are read in full to score their wording against the question. That comparison
# costs more than the rest of the query together, so it is spent only on chunks a cheaper signal
# already ranked highly. Raise it if a fuzzy phrase buried mid-document is being missed.
SCORING_POOL_CHUNKS=400
RERANKER_MAX_LENGTH=192

# Conversation. Retrieval answers with sources; this answers with prose, from a model running on
# your own machine. Nothing here ever reaches a third party: OLLAMA_BASE_URL is checked at
# start-up and refused unless it points at loopback, the container host, or a private address.
#
# Prerequisites, once: install Ollama on the host, then
#   OLLAMA_HOST=0.0.0.0 ollama serve   # so containers can reach it
#   ollama pull qwen3:8b
CHAT_ENABLED=false
CHAT_PROVIDER=ollama
# host.docker.internal is the host seen from inside a container. Running outside one, use
# http://127.0.0.1:11434 instead.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# qwen3:8b needs ~5.2GB resident. On 16GB, alongside the embedding and reranker models and
# Postgres, that is tight but workable; drop to qwen3:4b (2.5GB) if the machine starts swapping.
CHAT_MODEL=qwen3:8b
# Rewrites a follow-up into a standalone question before retrieval, so "and what about the second
# one?" still finds something. Empty stitches the recent turns together instead, which is cruder
# but costs no second model in memory. qwen3:1.7b is enough for the job.
CHAT_CONDENSE_MODEL=
# Ollama defaults every context window to 4096 whatever the model can hold, so this is always
# sent explicitly. It has to comfortably exceed CHAT_CONTEXT_CHARS / 3.
CHAT_NUM_CTX=16384
CHAT_TEMPERATURE=0.2
CHAT_MAX_TOKENS=1024
# Qwen3 reasons before answering unless told not to. For answers confined to retrieved sources
# that is latency spent on nothing the reader sees.
CHAT_THINKING=false
# How long Ollama keeps the model resident after an answer. Longer is faster, and costs the RAM.
CHAT_KEEP_ALIVE=10m
CHAT_HISTORY_TURNS=6
# Below DEFAULT_CONTEXT_CHARS on purpose: an agent with a large window can be handed more than a
# local model can read without losing the middle of it.
CHAT_CONTEXT_CHARS=12000
# Answer only from what was retrieved, and say so plainly when nothing was. Turning this off lets
# the model fall back on its training, which is the failure this index exists to prevent.
CHAT_REQUIRE_EVIDENCE=true
# A first call loads the model, which on a small machine can take a minute before a token appears.
CHAT_TIMEOUT_SECONDS=180
# Shared secret for the /v1 chat endpoints. Open WebUI sends it as a bearer token. Empty leaves
# them unauthenticated, which is only defensible while the port stays bound to loopback.
CHAT_API_KEY=

# MCP is published only on the host loopback interface by docker-compose.yml.
MCP_PORT=2600
MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,[::1],[::1]:*,host.docker.internal,host.docker.internal:*
LOG_LEVEL=INFO
# rich is readable in a terminal; json is what Loki can index. `make observability` needs json.
LOG_FORMAT=rich

# Observability stack, started separately with `make observability`. Loopback only, like MCP.
# Deliberately not 3000 or 5000: macOS AirPlay Receiver holds 5000.
GRAFANA_PORT=2601
PROMETHEUS_PORT=2602
LOKI_PORT=2603
MLFLOW_PORT=2604
# Open WebUI, started separately with `make chat`. Loopback only, like everything else.
OPEN_WEBUI_PORT=2605
GRAFANA_ADMIN_USER=admin
# No default on purpose. `make observability` refuses to start until you set one.
GRAFANA_ADMIN_PASSWORD=
# Where `make eval args='--track'` records runs. Empty means evaluations are not recorded.
MLFLOW_TRACKING_URI=http://mlflow:5000
