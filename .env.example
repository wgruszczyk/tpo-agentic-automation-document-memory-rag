# Database is internal to Docker Compose. Change passwords before remote deployment.
POSTGRES_DB=product_memory
POSTGRES_USER=product_memory
POSTGRES_PASSWORD=product_memory_local_only

# Local host folder mounted read-only into the container.
HOST_KNOWLEDGE_DIR=./knowledge
KNOWLEDGE_DIR=/knowledge
# Semicolon-separated folders to symlink into HOST_KNOWLEDGE_DIR with `make link-knowledge`.
# Use name=/absolute/path for stable source paths, or /absolute/path to use the folder name.
KNOWLEDGE_LINKED_DIRS=
SCAN_INTERVAL_SECONDS=30
SUPPORTED_EXTENSIONS=.txt,.md,.markdown,.rst,.log,.vtt,.srt,.pdf,.docx,.pptx,.xlsx,.msg,.eml,.png,.jpg,.jpeg,.tif,.tiff,.bmp,.webp,.gif

# Read text from pictures, scans, and images embedded in PDF/DOCX/PPTX files.
# Set ENABLE_OCR=false to index only text that is already machine readable.
ENABLE_OCR=true
# Tesseract language packs. The image ships eng and pol; add more in the Dockerfile.
OCR_LANGUAGES=eng+pol
OCR_MAX_IMAGES_PER_DOCUMENT=100
OCR_MIN_IMAGE_PIXELS=10000
OCR_MIN_CHARACTERS=12
OCR_TIMEOUT_SECONDS=30

# Chunking. A change triggers an automatic full reindex.
CHUNK_SIZE=1800
CHUNK_OVERLAP=250

# Default: multilingual, CPU-friendly local model. Polish and English are supported.
EMBEDDING_PROVIDER=local_hf
EMBEDDING_MODEL=intfloat/multilingual-e5-base
# Pin a Hugging Face commit for fully reproducible deployments. Empty means the model's current revision.
EMBEDDING_REVISION=
EMBEDDING_DIMENSIONS=
EMBEDDING_BATCH_SIZE=16
LOCAL_EMBEDDING_THREADS=4
HF_HOME=/models/huggingface

# The service reaches the internet only to fetch a model that is missing from HF_HOME, and never
# again once it is cached. Set false to forbid that too: a cold cache then fails with a clear
# error instead of pulling gigabytes, and `make warmup` becomes the only way to download.
ALLOW_MODEL_DOWNLOAD=true

# Optional remote/OpenAI-compatible embeddings. Used only when EMBEDDING_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Hybrid ranking weights. They should sum roughly to 1.0.
SEMANTIC_WEIGHT=0.72
LEXICAL_WEIGHT=0.13
RECENCY_WEIGHT=0.15
RECENCY_HALF_LIFE_DAYS=180

# Context returned to an agent.
# The floor is applied to semantic similarity only, so an older but relevant document is still returned.
MIN_SEMANTIC_SCORE=0.60
MAX_RETURNED_DOCUMENTS=25
DEFAULT_TOP_K_CHUNKS=10
DEFAULT_TOP_K_DOCUMENTS=7
DEFAULT_CONTEXT_CHARS=24000
MAX_FULL_DOCUMENT_CHARS=120000

# Reranking. A shortlist is read again with the question attached, which catches passages the
# search stage ranked below chunks that merely discuss the subject. It costs seconds per query,
# so set RERANKER_ENABLED=false where latency matters more than the answer.
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-base
# Pin a Hugging Face commit, as with EMBEDDING_REVISION. `make warmup` prints the current one.
RERANKER_REVISION=
RERANKER_WEIGHT=0.5
CANDIDATE_POOL_CHUNKS=40
CANDIDATE_POOL_PER_SIGNAL=25
# How many chunks are read in full to score their wording against the question. That comparison
# costs more than the rest of the query together, so it is spent only on chunks a cheaper signal
# already ranked highly. Raise it if a fuzzy phrase buried mid-document is being missed.
SCORING_POOL_CHUNKS=400
RERANKER_MAX_LENGTH=192

# MCP is published only on the host loopback interface by docker-compose.yml.
MCP_PORT=2600
MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,[::1],[::1]:*,host.docker.internal,host.docker.internal:*
LOG_LEVEL=INFO
# rich is readable in a terminal; json is what Loki can index. `make observability` needs json.
LOG_FORMAT=rich

# Observability stack, started separately with `make observability`. Loopback only, like MCP.
# Deliberately not 3000 or 5000: macOS AirPlay Receiver holds 5000.
GRAFANA_PORT=2601
PROMETHEUS_PORT=2602
LOKI_PORT=2603
GRAFANA_ADMIN_USER=admin
# No default on purpose. `make observability` refuses to start until you set one.
GRAFANA_ADMIN_PASSWORD=
