# Database is internal to Docker Compose. Change passwords before remote deployment.
POSTGRES_DB=product_memory
POSTGRES_USER=product_memory
POSTGRES_PASSWORD=product_memory_local_only

# Local host folder mounted read-only into the container.
HOST_KNOWLEDGE_DIR=./knowledge
KNOWLEDGE_DIR=/knowledge
SCAN_INTERVAL_SECONDS=5
SUPPORTED_EXTENSIONS=.txt,.md,.markdown,.rst,.log,.vtt,.srt

# Chunking. A change triggers an automatic full reindex.
CHUNK_SIZE=1800
CHUNK_OVERLAP=250

# Default: multilingual, CPU-friendly local model. Polish and English are supported.
EMBEDDING_PROVIDER=local_hf
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Pin a Hugging Face commit for fully reproducible deployments. Empty means the model's current revision.
EMBEDDING_REVISION=
EMBEDDING_DIMENSIONS=
EMBEDDING_BATCH_SIZE=16
LOCAL_EMBEDDING_THREADS=4
HF_HOME=/models/huggingface

# Optional remote/OpenAI-compatible embeddings. Used only when EMBEDDING_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Hybrid ranking weights. They should sum roughly to 1.0.
SEMANTIC_WEIGHT=0.72
LEXICAL_WEIGHT=0.13
RECENCY_WEIGHT=0.15
RECENCY_HALF_LIFE_DAYS=180

# Context returned to an agent.
DEFAULT_TOP_K_CHUNKS=10
DEFAULT_TOP_K_DOCUMENTS=3
DEFAULT_CONTEXT_CHARS=24000
MAX_FULL_DOCUMENT_CHARS=120000

# MCP is published only on the host loopback interface by docker-compose.yml.
MCP_PORT=8080
MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,[::1],[::1]:*,host.docker.internal,host.docker.internal:*
LOG_LEVEL=INFO
